{
    "schema_name": "FUTURES_BASE_SCHEMA_V1.0",
    "version": "1.0.0",
    "scope": "Perpetual Futures + Dated Futures",
    "deterministic": true,
    "zero_null_required": true,
    "default_float_dtype": "float32",
    "default_int_dtype": "int32",
    "default_bool_dtype": "bool",
    "canonical_event_clock": {
        "row_definition": "1 row = 1 synthetic event",
        "timestamp_column": "meta__timestamp",
        "sequence_column": "meta__sequence_id",
        "timezone": "UTC",
        "monotonic": true,
        "default_inter_event_us": 1000
    },
    "naming_standard": "family__name__mtf-none__strike-none__maturity-none",
    "supported_futures_types": [
        "perp",
        "dated"
    ],
    "columns": [
        {
            "name": "meta__timestamp",
            "family": "meta_qc_provenance",
            "dtype": "datetime64[ns, UTC]",
            "null_policy": "raise",
            "default_fill": null,
            "required": true,
            "description": "Canonical UTC event timestamp generated by CanonicalClock"
        },
        {
            "name": "meta__sequence_id",
            "family": "meta_qc_provenance",
            "dtype": "int64",
            "null_policy": "raise",
            "default_fill": null,
            "required": true,
            "description": "Strictly increasing deterministic sequence id"
        },
        {
            "name": "exchange",
            "family": "meta_qc_provenance",
            "dtype": "string",
            "null_policy": "raise",
            "default_fill": null,
            "required": true,
            "description": "Exchange source name"
        },
        {
            "name": "symbol",
            "family": "meta_qc_provenance",
            "dtype": "string",
            "null_policy": "raise",
            "default_fill": null,
            "required": true,
            "description": "Underlying symbol"
        },
        {
            "name": "futures_type",
            "family": "meta_qc_provenance",
            "dtype": "string",
            "allowed_values": [
                "perp",
                "dated"
            ],
            "null_policy": "raise",
            "default_fill": null,
            "required": true,
            "description": "Contract classification"
        },
        {
            "name": "mark_price",
            "family": "price_ohlcv",
            "dtype": "float32",
            "null_policy": "forward_fill_then_zero",
            "default_fill": 0.0,
            "required": true,
            "description": "Current futures mark price"
        },
        {
            "name": "index_price",
            "family": "price_ohlcv",
            "dtype": "float32",
            "null_policy": "forward_fill_then_zero",
            "default_fill": 0.0,
            "required": true,
            "description": "Reference spot index price"
        },
        {
            "name": "trade_volume",
            "family": "orderflow_tick",
            "dtype": "float32",
            "null_policy": "zero_if_missing",
            "default_fill": 0.0,
            "required": true,
            "description": "Executed traded volume"
        },
        {
            "name": "open_interest",
            "family": "futures",
            "dtype": "float32",
            "null_policy": "forward_fill_then_zero",
            "default_fill": 0.0,
            "required": true,
            "description": "Current open interest"
        },
        {
            "name": "basis",
            "family": "futures",
            "dtype": "float32",
            "null_policy": "compute_else_zero",
            "default_fill": 0.0,
            "required": true,
            "description": "Mark price minus index price"
        },
        {
            "name": "long_short_ratio",
            "family": "futures",
            "dtype": "float32",
            "null_policy": "compute_else_1.0",
            "default_fill": 1.0,
            "required": true,
            "description": "Long versus short positioning ratio"
        },
        {
            "name": "long_liquidation_volume",
            "family": "futures",
            "dtype": "float32",
            "null_policy": "zero_if_missing",
            "default_fill": 0.0,
            "required": true,
            "description": "Long-side liquidation volume"
        },
        {
            "name": "short_liquidation_volume",
            "family": "futures",
            "dtype": "float32",
            "null_policy": "zero_if_missing",
            "default_fill": 0.0,
            "required": true,
            "description": "Short-side liquidation volume"
        },
        {
            "name": "funding_rate",
            "family": "futures",
            "dtype": "float32",
            "applies_to": [
                "perp"
            ],
            "null_policy": "compute_else_zero",
            "default_fill": 0.0,
            "required": false,
            "description": "Perpetual funding rate"
        },
        {
            "name": "funding_interval_hours",
            "family": "futures",
            "dtype": "int32",
            "applies_to": [
                "perp"
            ],
            "null_policy": "compute_else_zero",
            "default_fill": 8,
            "required": false,
            "description": "Funding settlement interval"
        },
        {
            "name": "expiry",
            "family": "futures",
            "dtype": "datetime64[ns, UTC]",
            "applies_to": [
                "dated"
            ],
            "null_policy": "raise",
            "default_fill": null,
            "required": false,
            "description": "Contract expiry timestamp"
        },
        {
            "name": "days_to_expiry",
            "family": "futures",
            "dtype": "int32",
            "applies_to": [
                "dated"
            ],
            "null_policy": "compute_else_zero",
            "default_fill": 0,
            "required": false,
            "description": "Days remaining until expiry"
        },
        {
            "name": "contract_month",
            "family": "futures",
            "dtype": "string",
            "applies_to": [
                "dated"
            ],
            "null_policy": "raise",
            "default_fill": null,
            "required": false,
            "description": "Named contract month"
        },
        {
            "name": "settlement_type",
            "family": "futures",
            "dtype": "string",
            "applies_to": [
                "dated"
            ],
            "allowed_values": [
                "cash",
                "physical"
            ],
            "null_policy": "raise",
            "default_fill": null,
            "required": false,
            "description": "Settlement style"
        }
    ],
    "validation_rules": {
        "strict_dtype_enforcement": true,
        "fail_on_null": true,
        "fail_on_non_monotonic_sequence": true,
        "fail_on_non_utc_timestamp": true,
        "bool_to_int_conversion": false,
        "deterministic_output_required": true
    },
    "parquet_output_standard": {
        "partition_by": [
            "date"
        ],
        "compression": "snappy",
        "atomic_writes": true,
        "part_file_pattern": "<base>.part-00000.parquet",
        "final_merge_order": "sorted_by_part_filename",
        "final_output_pattern": "<paths.base>/<engine_relative_path>/date=YYYY-MM-DD/<dataset>.parquet"
    }
}